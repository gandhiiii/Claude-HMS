{
  "name": "stavya-intelligence-hms",
  "version": "1.0.0",
  "description": "Stavya Intelligence HMS - Hospital Management System",
  "main": "electron/main.js",
  "scripts": {
    "server:start": "node server/ws-server.js",
    "watch": "node scripts/watch-and-sync.js",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win portable",
    "build:exe": "npm run electron:build",
    "build:www": "node scripts/build-www.js",
    "capacitor:sync": "npm run build:www && npx cap sync android",
    "capacitor:open": "npx cap open android",
    "build:apk": "npm run capacitor:sync && cd android && .\\gradlew assembleDebug"
  },
  "build": {
    "appId": "com.stavya.hms",
    "productName": "Stavya Intelligence HMS",
    "asar": false,
    "directories": {
      "output": "dist/exe"
    },
    "files": [
      "electron/**/*",
      "hms_flutter/build/web/**/*",
      "assets/**/*",
      "css/**/*",
      "js/**/*",
      "*.html",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "assets/stavya-logo.png"
    }
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
