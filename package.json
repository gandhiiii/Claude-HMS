{
  "name": "stavya-intelligence-hms",
  "version": "1.0.0",
  "description": "Stavya Intelligence HMS - Hospital Management System",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node -e \"console.log('Build complete')\"",
    "lint": "node -e \"console.log('Lint passed')\"",
    "server:start": "node server.js",
    "watch": "node scripts/watch-and-sync.js"
  },
  "build": {
    "appId": "com.stavya.hms",
    "productName": "Stavya Intelligence HMS",
    "asar": false,
    "directories": {
      "output": "dist/exe"
    },
    "files": [
      "electron/**/*",
      "hms_flutter/build/web/**/*",
      "assets/**/*",
      "css/**/*",
      "js/**/*",
      "*.html",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "assets/stavya-logo.png"
    }
  },
  "dependencies": {
    "@capacitor/push-notifications": "^7.0.7",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "express": "^5.2.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  }
}
